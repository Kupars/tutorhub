/*
  Cache-Control: public, max-age=300

/
  ! Cache-Control
  Cache-Control: no-cache, must-revalidate

/index.html
  ! Cache-Control
  Cache-Control: no-cache, must-revalidate

/js/*
  ! Cache-Control
  Cache-Control: public, max-age=3600

/css/*
  ! Cache-Control
  Cache-Control: public, max-age=3600

/data/*
  ! Cache-Control
  Cache-Control: public, max-age=300

/assets/*
  ! Cache-Control
  Cache-Control: public, max-age=86400
