/*
  Cache-Control: public, max-age=300
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), payment=(), usb=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-eval' https://*.amap.com https://*.autonavi.com https://*.a-map.cn; style-src 'self' 'unsafe-inline' https://*.amap.com https://*.autonavi.com https://*.a-map.cn; img-src 'self' data: blob: https://tile.openstreetmap.org https://*.amap.com https://*.autonavi.com https://*.a-map.cn; font-src 'self' data: https://*.amap.com https://*.autonavi.com https://*.a-map.cn; connect-src 'self' https://*.amap.com https://*.autonavi.com https://*.a-map.cn; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'; upgrade-insecure-requests

/
  ! Cache-Control
  Cache-Control: no-cache, must-revalidate

/index.html
  ! Cache-Control
  Cache-Control: no-cache, must-revalidate

/js/*
  ! Cache-Control
  Cache-Control: public, max-age=3600

/css/*
  ! Cache-Control
  Cache-Control: public, max-age=3600

/data/*
  ! Cache-Control
  Cache-Control: public, max-age=300

/assets/*
  ! Cache-Control
  Cache-Control: public, max-age=86400
